@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? "";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Goan</title>
    <meta name="description" content="Goan - Website hoc tu vung tieng Anh voi Flashcard, Test, Match Game" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-book-open me-2"></i>Goan
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Trang chu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Explore"><i class="fas fa-compass me-1"></i>Kham pha</a>
                    </li>
                    @if (isAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Progress/Dashboard"><i class="fas fa-chart-line me-1"></i>Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/VocabularySet/MySets"><i class="fas fa-layer-group me-1"></i>Bo tu cua toi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Lecture"><i class="fas fa-book-reader me-1"></i>Bai giang</a>
                        </li>
                        @if (userRole == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/Admin"><i class="fas fa-shield-alt me-1"></i>Quan tri</a>
                            </li>
                        }
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i>@userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Progress/Dashboard"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" href="/VocabularySet/MySets"><i class="fas fa-layer-group me-2"></i>Bo tu cua toi</a></li>
                                <li><a class="dropdown-item" href="/Test/History"><i class="fas fa-history me-2"></i>Lich su test</a></li>
                                <li><hr class="dropdown-menu-divider" /></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i>Dang xuat</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Login"><i class="fas fa-sign-in-alt me-1"></i>Dang nhap</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-light btn-sm ms-2 px-3 rounded-pill" href="/Auth/Register">
                                <i class="fas fa-user-plus me-1"></i>Dang ky
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("PinnedTabs")
    }

    <main>
        @RenderBody()
    </main>

    <footer class="footer-section">
        <div class="container text-center">
            <p class="mb-1"><i class="fas fa-book-open me-2"></i>Goan - Hoc tu vung tieng Anh</p>
            <p class="mb-0 small opacity-75">&copy; 2026 Goan. Tran Nguyen Bao An - MSSV: 2001230004</p>
        </div>
    </footer>

    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
        @if (TempData["Success"] != null)
        {
            <div class="toast show align-items-center text-white bg-success border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="toast show align-items-center text-white bg-danger border-0" role="alert">
                <div class="d-flex">
                    <div class="toast-body"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <button class="btn btn-primary-gradient rounded-circle shadow-lg dict-fab" type="button" data-bs-toggle="offcanvas" data-bs-target="#dictOffcanvas" aria-controls="dictOffcanvas" title="Tra tu bang AI">
        <i class="fas fa-search"></i>
    </button>

    <div class="offcanvas offcanvas-end shadow" tabindex="-1" id="dictOffcanvas" aria-labelledby="dictOffcanvasLabel" data-bs-scroll="true" data-bs-backdrop="false">
        <div class="resize-handle" id="offcanvasResizeHandle"></div>
        <div class="offcanvas-header bg-light-custom border-bottom flex-shrink-0">
            <h5 class="offcanvas-title fw-bold" id="dictOffcanvasLabel"><i class="fas fa-wand-magic-sparkles me-2 text-primary"></i>Tra tu AI</h5>
            <div class="d-flex align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Pin" asp-action="TogglePin" method="post" class="mb-0 me-2 d-inline-block">
                        <input type="hidden" name="itemType" value="Dictionary" />
                        <input type="hidden" name="title" value="Tu dien" />
                        <input type="hidden" name="url" value="#" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" id="btnPinDict" class="btn btn-sm btn-outline-primary" title="Ghim tra tu AI vao thanh tab">
                            <i class="fas fa-thumbtack"></i>
                        </button>
                    </form>
                }
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
        </div>

        <div class="offcanvas-split-container" id="offcanvasSplitContainer">
            <div class="split-panel" id="dictPanel">
                <div class="split-panel-inner">
                    <form id="dictForm" class="mb-4">
                        <div class="input-group shadow-sm rounded-pill overflow-hidden">
                            <input type="text" id="dictInput" class="form-control border-0 px-4" placeholder="Nhap tu tieng Anh hoac tieng Viet..." required autocomplete="off">
                            <button class="btn btn-primary-gradient px-4" type="submit" id="dictSubmitBtn"><i class="fas fa-search"></i></button>
                        </div>
                    </form>

                    <div id="dictLoading" class="text-center d-none py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted mt-2 small">Gemini dang tra tu...</p>
                    </div>

                    <div id="dictResult" class="d-none">
                        <div class="mb-3 d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <h2 class="fw-bold text-primary mb-1 text-capitalize" id="dictWord">word</h2>
                                <span class="text-muted font-monospace fs-5" id="dictIpa">/word/</span>
                            </div>
                            <button class="btn btn-sm btn-outline-primary rounded-circle speak-btn" type="button" id="dictSpeakBtn" title="Phat am">
                                <i class="fas fa-volume-high"></i>
                            </button>
                        </div>

                        <div class="mb-4">
                            <div class="p-3 bg-primary-subtle rounded-3 shadow-sm border-start border-4 border-primary">
                                <span class="fs-5 fw-bold text-primary text-capitalize" id="dictMeaning"></span>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="mb-4 bg-light p-3 rounded-3 shadow-sm border">
                                <label class="form-label fw-bold small text-muted"><i class="fas fa-plus-circle me-1"></i>Luu vao bo tu vung</label>
                                <div class="input-group">
                                    <select id="dictSaveSetSelect" class="form-select form-select-sm">
                                        <option value="">Dang tai...</option>
                                    </select>
                                    <button id="dictSaveWordBtn" class="btn btn-sm btn-primary" type="button">Luu tu</button>
                                </div>
                                <div id="dictSaveMsg" class="small mt-2 d-none"></div>
                            </div>
                        }

                        <div id="dictMeaningsContainer"></div>
                    </div>

                    <div id="dictError" class="d-none alert alert-danger rounded-3 shadow-sm">
                        <i class="fas fa-exclamation-triangle me-2"></i><span id="dictErrorText">Khong tim thay tu nay.</span>
                    </div>
                </div>
            </div>

            <div class="panel-splitter" id="panelSplitter" title="Keo de thay doi kich thuoc">
                <div class="splitter-grip">
                    <span></span><span></span><span></span>
                </div>
            </div>

            <div class="split-panel" id="aiPanel">
                <div class="split-panel-inner">
                    <section class="ai-chat-panel h-100 d-flex flex-column">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-shrink-0">
                            <h6 class="fw-bold mb-0"><i class="fas fa-notes-medical me-2 text-primary"></i>Khong gian hoc tap</h6>
                        </div>

                        <ul class="nav nav-pills notebook-tabs mb-3 flex-shrink-0" id="workspaceTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="workspace-chat-tab" data-bs-toggle="pill" data-bs-target="#workspace-chat-pane" type="button" role="tab" aria-controls="workspace-chat-pane" aria-selected="true">Hoi AI</button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="workspace-note-tab" data-bs-toggle="pill" data-bs-target="#workspace-note-pane" type="button" role="tab" aria-controls="workspace-note-pane" aria-selected="false">So tay</button>
                            </li>
                        </ul>

                        <div class="tab-content flex-grow-1 d-flex flex-column min-h-0">
                            <div class="tab-pane fade show active flex-grow-1 min-h-0" id="workspace-chat-pane" role="tabpanel" aria-labelledby="workspace-chat-tab">
                                <div class="h-100 d-flex flex-column">
                                    <div class="d-flex gap-2 mb-3 flex-shrink-0">
                                        <select class="form-select form-select-sm" id="aiConversationSelect" aria-label="Lich su hoi thoai">
                                            <option value="">Cuoc tro chuyen moi</option>
                                        </select>
                                        <button class="btn btn-sm btn-outline-primary" type="button" id="aiNewChatBtn" title="Tao moi">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" type="button" id="aiDeleteChatBtn" title="Xoa cuoc tro chuyen">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>

                                    <div id="aiChatError" class="alert alert-danger d-none rounded-3 shadow-sm small flex-shrink-0"></div>

                                    <div id="aiChatMessages" class="ai-chat-messages mb-3 flex-grow-1">
                                        <div class="ai-empty-state text-center text-muted py-4">
                                            <i class="fas fa-wand-magic-sparkles fs-2 mb-3 text-primary"></i>
                                            <p class="mb-1 fw-semibold">Hoi AI ve tu vung, vi du, ngu phap.</p>
                                            <p class="small mb-0">Lich su se duoc luu rieng cho tai khoan cua ban.</p>
                                        </div>
                                    </div>

                                    <form id="aiChatForm" class="flex-shrink-0">
                                        <div class="ai-chat-composer shadow-sm">
                                            <textarea id="aiChatInput" class="form-control border-0" rows="2" placeholder="Vi du: Phan biet affect va effect..." required></textarea>
                                            <button class="btn btn-primary-gradient ai-chat-send" type="submit" id="aiChatSendBtn">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        </div>
                                    </form>
                                    <div id="aiChatLoading" class="small text-muted mt-2 d-none flex-shrink-0">
                                        <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Gemini dang tra loi...
                                    </div>
                                </div>
                            </div>

                            <div class="tab-pane fade flex-grow-1 min-h-0" id="workspace-note-pane" role="tabpanel" aria-labelledby="workspace-note-tab">
                                <div class="h-100 d-flex flex-column">
                                    <div class="d-flex gap-2 mb-3 flex-shrink-0">
                                        <input type="search" id="noteSearchInput" class="form-control form-control-sm" placeholder="Tim trong so tay...">
                                        <button class="btn btn-sm btn-outline-primary" type="button" id="noteSearchBtn" title="Tim">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary" type="button" id="noteNewBtn" title="Note moi">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>

                                    <div class="d-flex gap-2 mb-3 flex-shrink-0">
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="noteUseWordBtn">Tu dang tra</button>
                                        <button class="btn btn-sm btn-outline-secondary" type="button" id="noteUseAiBtn">Lay tu AI</button>
                                    </div>

                                    <div id="noteError" class="alert alert-danger d-none rounded-3 shadow-sm small flex-shrink-0"></div>
                                    <div id="noteSaveMsg" class="alert alert-success d-none rounded-3 shadow-sm small flex-shrink-0"></div>

                                    <div id="noteList" class="note-list mb-3 flex-shrink-0">
                                        <div class="text-muted small">Chua co note nao.</div>
                                    </div>

                                    <form id="noteForm" class="d-flex flex-column flex-grow-1 min-h-0 overflow-y-auto pe-2">
                                        <input type="hidden" id="noteId">
                                        <div class="row g-2 mb-2 flex-shrink-0">
                                            <div class="col-12">
                                                <input type="text" id="noteTitleInput" class="form-control form-control-sm" placeholder="Tieu de note">
                                            </div>
                                            <div class="col-6">
                                                <input type="text" id="noteRelatedTermInput" class="form-control form-control-sm" placeholder="Tu lien quan">
                                            </div>
                                            <div class="col-6">
                                                <select id="noteSetSelect" class="form-select form-select-sm">
                                                    <option value="">Khong gan bo tu</option>
                                                </select>
                                            </div>
                                            <div class="col-12">
                                                <input type="text" id="noteTagsInput" class="form-control form-control-sm" placeholder="Tags: toeic, de nham, can nho">
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div id="workspaceQuillContainer" class="bg-white" style="height: 150px; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;"></div>
                                            <textarea id="noteContentInput" class="d-none"></textarea>
                                        </div>

                                        <div class="d-flex gap-2 flex-shrink-0">
                                            <button class="btn btn-outline-secondary btn-sm" type="button" id="notePinBtn">
                                                <i class="fas fa-thumbtack me-1"></i>Ghim
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm" type="button" id="noteDeleteBtn">
                                                <i class="fas fa-trash me-1"></i>Xoa
                                            </button>
                                            <button class="btn btn-primary-gradient btn-sm ms-auto" type="submit" id="noteSaveBtn">
                                                <i class="fas fa-floppy-disk me-1"></i>Luu note
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
    <script src="~/js/site.js?v=@DateTime.Now.Ticks" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
