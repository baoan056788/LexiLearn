@model LexiLearn.ViewModels.LectureUploadViewModel
@{
    ViewData["Title"] = "Chinh sua bai giang";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-warning" style="border-width: 1px;">
                <div class="card-header border-bottom bg-transparent py-3">
                    <h4 class="mb-0 text-dark"><i class="fas fa-edit text-warning me-2"></i> Chinh sua bai giang</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" enctype="multipart/form-data" method="post" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="LectureId" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label text-dark fw-bold">Tieu de bai giang <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Nhap tieu de bai giang" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label text-dark fw-bold">Mo ta</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Mo ta ngan gon ve noi dung bai giang..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label text-dark fw-bold">Danh muc</label>
                                <select asp-for="CategoryId" class="form-select">
                                    <option value="">-- Chon danh muc --</option>
                                    @foreach (var item in Model.Categories)
                                    {
                                        <option value="@item.CategoryId">@item.CategoryName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CourseId" class="form-label text-dark fw-bold">Khoa hoc (Tuy chon)</label>
                                <select asp-for="CourseId" class="form-select">
                                    <option value="">-- Khong thuoc khoa hoc --</option>
                                    @foreach (var item in Model.Courses)
                                    {
                                        <option value="@item.CourseId">@item.Title</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-dark fw-bold">Cap nhat File Word (.docx) <span class="text-muted small fw-normal">(Khong bat buoc)</span></label>
                            <div class="alert alert-warning bg-transparent border-warning text-warning small p-2 mb-2">
                                <i class="fas fa-exclamation-triangle me-1"></i> Neu ban tai len file moi, toan bo noi dung, muc luc va cau hoi trac nghiem cu se bi thay the!
                            </div>
                            <div class="upload-area p-3 text-center border border-2 border-dashed rounded bg-light position-relative" id="dropArea">
                                <input type="file" asp-for="WordFile" class="position-absolute top-0 start-0 w-100 h-100 opacity-0" style="cursor: pointer;" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" id="fileInput" />
                                <i class="fas fa-file-upload fa-2x text-muted mb-2"></i>
                                <h6 class="text-dark mb-1">Chon file moi de thay the (Hoac keo tha)</h6>
                                <p class="text-muted small mb-0" id="fileName">Giu nguyen de khong thay doi file hien tai</p>
                            </div>
                            <span asp-validation-for="WordFile" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4 form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="IsPublic" id="isPublicSwitch">
                            <label class="form-check-label text-dark" for="isPublicSwitch">
                                <i class="fas fa-globe me-1"></i> Cong khai bai giang nay
                            </label>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@Model.LectureId" class="btn btn-outline-secondary">Huy</a>
                            <button type="submit" class="btn btn-warning text-dark fw-bold px-4" id="submitBtn">
                                <span class="normal-state"><i class="fas fa-save me-2"></i> Luu thay doi</span>
                                <span class="loading-state d-none">
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    Dang xu ly...
                                </span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('fileInput');
            const dropArea = document.getElementById('dropArea');
            const fileName = document.getElementById('fileName');
            const form = document.getElementById('editForm');
            const submitBtn = document.getElementById('submitBtn');

            fileInput.addEventListener('change', function () {
                if (this.files && this.files.length > 0) {
                    const file = this.files[0];
                    if (!file.name.toLowerCase().endsWith('.docx')) {
                        alert('Vui long chon file .docx');
                        this.value = '';
                        fileName.innerHTML = 'Giu nguyen de khong thay doi file hien tai';
                        return;
                    }
                    fileName.innerHTML = `<strong class="text-warning"><i class="fas fa-file-word me-1"></i> ${file.name}</strong> se thay the file cu`;
                    dropArea.classList.add('border-warning');
                } else {
                    fileName.innerHTML = 'Giu nguyen de khong thay doi file hien tai';
                    dropArea.classList.remove('border-warning');
                }
            });

            // Loading state
            form.addEventListener('submit', function (e) {
                if ($(this).valid()) {
                    const normalState = submitBtn.querySelector('.normal-state');
                    const loadingState = submitBtn.querySelector('.loading-state');
                    
                    submitBtn.disabled = true;
                    normalState.classList.add('d-none');
                    loadingState.classList.remove('d-none');
                }
            });
        });
    </script>
}
