@model LexiLearn.ViewModels.LectureQuizViewModel
@{
    ViewData["Title"] = "Bai tap: " + Model.LectureTitle;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row">
        <!-- Main Quiz Content -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0 text-dark">Luyen tap trac nghiem</h2>
                    <p class="text-muted mb-0">Tu bai giang: <a href="/Lecture/Details/@Model.LectureId" class="text-primary text-decoration-none">@Model.LectureTitle</a></p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary p-2 fs-6"><i class="fas fa-list-ol me-1"></i> @Model.TotalQuestions cau hoi</span>
                </div>
            </div>

            <div class="card shadow-sm border-primary mb-4" style="border-width: 2px;">
                <div class="card-body p-5">
                    <div id="quizContainer">
                        <input type="hidden" id="lectureId" value="@Model.LectureId" />

                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];
                            <div class="quiz-item mb-5 pb-4 border-bottom border-light" id="quiz_@q.QuizId">
                                <h5 class="text-dark mb-4 d-flex align-items-start">
                                    <span class="badge bg-secondary me-2 mt-1">Cau @(i + 1)</span> 
                                    <span class="q-content flex-grow-1" data-quiz-id="@q.QuizId" id="qcontent_@q.QuizId">@q.QuestionText</span>
                                    <button type="button" class="btn btn-sm btn-outline-warning ms-2 flag-btn" data-quiz-id="@q.QuizId" title="Đánh dấu câu quan trọng">
                                        <i class="far fa-star"></i>
                                    </button>
                                </h5>

                                <div class="options-container ms-3">
                                    @if (!string.IsNullOrEmpty(q.OptionA))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_a" value="A" required>
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_a">
                                                <span class="option-letter">A</span> @q.OptionA
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionB))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_b" value="B">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_b">
                                                <span class="option-letter">B</span> @q.OptionB
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionC))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_c" value="C">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_c">
                                                <span class="option-letter">C</span> @q.OptionC
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionD))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_d" value="D">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_d">
                                                <span class="option-letter">D</span> @q.OptionD
                                            </label>
                                        </div>
                                    }
                                </div>
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-primary check-btn shadow-sm" data-quiz-id="@q.QuizId" data-needs-analysis="@(string.IsNullOrEmpty(q.Explanation) ? "true" : "false")">
                                        <i class="fas fa-robot me-1"></i> Kiểm tra bằng AI
                                    </button>
                                </div>
                                <div id="explanation_@q.QuizId" class="mt-3 d-none p-4 rounded bg-light border border-info shadow-sm" style="font-size: 0.95em;">
                                    <!-- AI Explanation will be injected here -->
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-center mt-5">
                            <a href="/Lecture/Details/@Model.LectureId" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại bài giảng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Sidebar Index -->
        <div class="col-lg-3 col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 80px; z-index: 100;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold fs-6"><i class="fas fa-list-ol me-2"></i> Mục lục câu hỏi</h5>
                    <small class="text-white-50">Tổng cộng @Model.TotalQuestions câu</small>
                </div>
                <div class="card-body bg-light">
                    <div class="mb-3 d-flex flex-wrap gap-1 border-bottom pb-3">
                        <button class="btn btn-sm btn-primary flex-grow-1 filter-btn fw-bold shadow-sm" data-filter="all">Tất cả</button>
                        <button class="btn btn-sm btn-outline-danger flex-grow-1 filter-btn fw-bold" data-filter="wrong">Làm lại câu sai</button>
                        <button class="btn btn-sm btn-outline-warning flex-grow-1 filter-btn text-dark fw-bold" data-filter="starred">Câu gắn sao</button>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3" id="indexContainer">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];
                            <a href="#quiz_@q.QuizId" id="index_btn_@q.QuizId" class="btn btn-outline-secondary btn-sm position-relative" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem; border-radius: 8px;">
                                @(i + 1)
                                <i class="fas fa-star text-warning position-absolute d-none flag-icon" id="index_star_@q.QuizId" style="top: -5px; right: -5px; font-size: 14px; text-shadow: 0 0 2px rgba(0,0,0,0.5);"></i>
                            </a>
                        }
                    </div>
                    <hr>
                    <div class="d-flex flex-column gap-2 small text-muted">
                        <div class="d-flex align-items-center"><div class="bg-success rounded me-2" style="width: 15px; height: 15px;"></div> Đã làm đúng</div>
                        <div class="d-flex align-items-center"><div class="bg-danger rounded me-2" style="width: 15px; height: 15px;"></div> Làm sai</div>
                        <div class="d-flex align-items-center"><div class="border border-secondary rounded me-2" style="width: 15px; height: 15px;"></div> Chưa kiểm tra</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="highlight-tooltip" class="position-absolute d-none" style="z-index: 1000; padding: 8px 12px; background: white; border-radius: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid #eee; display: flex; gap: 10px; align-items: center;">
    <button class="btn-color-pick shadow-sm" style="background-color: #FFF176; width: 24px; height: 24px; border-radius: 50%; border: 2px solid white; cursor: pointer; transition: transform 0.2s;" data-color="#FFF176" title="Vàng" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></button>
    <button class="btn-color-pick shadow-sm" style="background-color: #81C784; width: 24px; height: 24px; border-radius: 50%; border: 2px solid white; cursor: pointer; transition: transform 0.2s;" data-color="#81C784" title="Xanh lá" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></button>
    <button class="btn-color-pick shadow-sm" style="background-color: #64B5F6; width: 24px; height: 24px; border-radius: 50%; border: 2px solid white; cursor: pointer; transition: transform 0.2s;" data-color="#64B5F6" title="Xanh dương" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></button>
    <button class="btn-color-pick shadow-sm" style="background-color: #E57373; width: 24px; height: 24px; border-radius: 50%; border: 2px solid white; cursor: pointer; transition: transform 0.2s;" data-color="#E57373" title="Đỏ" onmouseover="this.style.transform='scale(1.2)'" onmouseout="this.style.transform='scale(1)'"></button>
</div>

<style>
    .custom-radio .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.4em;
        border-color: #6366f1;
    }
    .custom-radio .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }
    
    .option-label {
        transition: all 0.2s ease;
        cursor: pointer;
        border: 1px solid transparent;
    }
    
    .option-label:hover {
        background-color: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
    }
    
    .form-check-input:checked + .option-label {
        background-color: rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.5);
    }
    
    .option-letter {
        display: inline-block;
        width: 24px;
        height: 24px;
        background-color: rgba(255,255,255,0.1);
        text-align: center;
        border-radius: 50%;
        line-height: 24px;
        font-weight: bold;
        margin-right: 10px;
        font-size: 0.85em;
    }
    
    .form-check-input:checked + .option-label .option-letter {
        background-color: #6366f1;
        color: white;
    }

    html {
        scroll-behavior: smooth;
    }
    
    /* Highlight the target when scrolling to it */
    .quiz-item:target {
        animation: highlight 2s ease;
    }
    
    @@keyframes highlight {
        0% { background-color: rgba(99, 102, 241, 0.2); }
        100% { background-color: transparent; }
    }

    mark {
        cursor: pointer;
        transition: opacity 0.2s;
    }
    mark:hover {
        opacity: 0.7;
    }
    
    .flag-btn i.fas {
        color: #ffc107;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const lectureId = document.getElementById('lectureId').value;
            const storageKey = `lexilearn_quiz_progress_${lectureId}`;
            
            // Load saved progress
            let savedProgress = {};
            try {
                const stored = localStorage.getItem(storageKey);
                if (stored) {
                    savedProgress = JSON.parse(stored);
                }
            } catch (e) {
                console.error("Could not parse saved progress", e);
            }
            
            // Function to render AI result
            function renderResult(quizId, result, selectedAnswer) {
                const radios = document.querySelectorAll(`input[name="answers[${quizId}]"]`);
                radios.forEach(r => {
                    const label = document.querySelector(`label[for="${r.id}"]`);
                    label.classList.remove('bg-success', 'bg-danger', 'text-white', 'text-dark');
                    label.classList.add('text-dark');
                    
                    if (r.value === result.correctAnswer) {
                        label.classList.remove('text-dark');
                        label.classList.add('bg-success', 'text-white');
                    }
                    
                    if (r.value === selectedAnswer && !result.isCorrect) {
                        label.classList.remove('text-dark');
                        label.classList.add('bg-danger', 'text-white');
                    }
                    
                    if (r.value === selectedAnswer) {
                        r.checked = true;
                    }
                });
                
                const explanationDiv = document.getElementById(`explanation_${quizId}`);
                explanationDiv.innerHTML = result.explanationHtml;
                explanationDiv.classList.remove('d-none');
                
                const btn = document.querySelector(`.check-btn[data-quiz-id="${quizId}"]`);
                if (btn) {
                    btn.innerHTML = '<i class="fas fa-check me-1"></i> Đã kiểm tra';
                    btn.disabled = true;
                }
                
                const indexBtn = document.getElementById(`index_btn_${quizId}`);
                if (indexBtn) {
                    indexBtn.classList.remove('btn-outline-secondary');
                    indexBtn.classList.add('text-white');
                    if (result.isCorrect) {
                        indexBtn.classList.add('btn-success');
                    } else {
                        indexBtn.classList.add('btn-danger');
                    }
                }
            }

            // Restore state on load
            Object.keys(savedProgress).forEach(quizIdStr => {
                const quizId = parseInt(quizIdStr);
                const data = savedProgress[quizIdStr];
                
                if (data.selectedAnswer && !data.result) {
                    const radio = document.querySelector(`input[name="answers[${quizId}]"][value="${data.selectedAnswer}"]`);
                    if (radio) radio.checked = true;
                }
                
                if (data.result) {
                    renderResult(quizId, data.result, data.selectedAnswer);
                }

                if (data.isFlagged) {
                    const flagBtn = document.querySelector(`.flag-btn[data-quiz-id="${quizId}"] i`);
                    if (flagBtn) {
                        flagBtn.classList.remove('far');
                        flagBtn.classList.add('fas');
                    }
                    const indexStar = document.getElementById(`index_star_${quizId}`);
                    if (indexStar) indexStar.classList.remove('d-none');
                }

                if (data.htmlContent) {
                    const qContent = document.getElementById(`qcontent_${quizId}`);
                    if (qContent) qContent.innerHTML = data.htmlContent;
                }
            });

            // Handle Flagging
            document.querySelectorAll('.flag-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const quizId = this.getAttribute('data-quiz-id');
                    const icon = this.querySelector('i');
                    const isFlagged = icon.classList.contains('fas');
                    
                    if (isFlagged) {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                    } else {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                    }
                    
                    const indexStar = document.getElementById(`index_star_${quizId}`);
                    if (indexStar) {
                        if (isFlagged) indexStar.classList.add('d-none');
                        else indexStar.classList.remove('d-none');
                    }

                    if (!savedProgress[quizId]) savedProgress[quizId] = {};
                    savedProgress[quizId].isFlagged = !isFlagged;
                    localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                });
            });

            // Handle Highlighting
            const tooltip = document.getElementById('highlight-tooltip');
            let currentHighlightRange = null;
            let currentQuizContent = null;

            document.addEventListener('mouseup', function(e) {
                const selection = window.getSelection();
                
                if (selection.toString().trim() !== '') {
                    const range = selection.getRangeAt(0);
                    const qContent = range.commonAncestorContainer.nodeType === 3 
                        ? range.commonAncestorContainer.parentElement.closest('.q-content')
                        : range.commonAncestorContainer.closest('.q-content');
                        
                    if (qContent) {
                        const rect = range.getBoundingClientRect();
                        tooltip.style.top = (window.scrollY + rect.top - 45) + 'px';
                        tooltip.style.left = (window.scrollX + rect.left + (rect.width / 2) - 15) + 'px';
                        tooltip.classList.remove('d-none');
                        
                        currentHighlightRange = range;
                        currentQuizContent = qContent;
                        return;
                    }
                }
                
                if (!e.target.closest('#highlight-tooltip')) {
                    tooltip.classList.add('d-none');
                    currentHighlightRange = null;
                    currentQuizContent = null;
                }
            });

            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const nameAttr = this.getAttribute('name');
                    const match = nameAttr.match(/answers\[(\d+)\]/);
                    if (match) {
                        const quizId = match[1];
                        
                        // Clear visual state to unlock question for re-checking
                        const radios = document.querySelectorAll(`input[name="answers[${quizId}]"]`);
                        radios.forEach(r => {
                            const label = document.querySelector(`label[for="${r.id}"]`);
                            label.classList.remove('bg-success', 'bg-danger', 'text-white');
                            label.classList.add('text-dark');
                        });
                        
                        const explanationDiv = document.getElementById(`explanation_${quizId}`);
                        if (explanationDiv) explanationDiv.classList.add('d-none');
                        
                        const btn = document.querySelector(`.check-btn[data-quiz-id="${quizId}"]`);
                        if (btn) {
                            btn.innerHTML = '<i class="fas fa-robot me-1"></i> Kiểm tra lại bằng AI';
                            btn.disabled = false;
                            btn.classList.remove('btn-secondary');
                            btn.classList.add('btn-primary');
                        }
                        
                        const indexBtn = document.getElementById(`index_btn_${quizId}`);
                        if (indexBtn) {
                            indexBtn.classList.remove('btn-success', 'btn-danger', 'text-white');
                            indexBtn.classList.add('btn-outline-secondary');
                        }

                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].selectedAnswer = this.value;
                        if (savedProgress[quizId].result) delete savedProgress[quizId].result;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                    }
                });
            });

            // Filter logic
            let currentFilter = 'all';
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const filter = this.dataset.filter;
                    if (filter === currentFilter) return;

                    const matchingQuizIds = [];
                    
                    // 1. Determine which questions match based on localStorage data
                    Object.keys(savedProgress).forEach(quizIdStr => {
                        const quizId = parseInt(quizIdStr);
                        const data = savedProgress[quizIdStr];
                        if (filter === 'wrong') {
                            if (data.result && data.result.isCorrect === false) matchingQuizIds.push(quizId);
                        } else if (filter === 'starred') {
                            if (data.isFlagged) matchingQuizIds.push(quizId);
                        }
                    });
                    
                    // 2. Perform the temporary visual reset (if not 'all')
                    if (filter !== 'all') {
                        if (matchingQuizIds.length === 0) {
                            Swal.fire({
                                icon: 'info',
                                title: 'Không tìm thấy câu hỏi',
                                text: 'Không có câu hỏi nào thỏa mãn điều kiện lọc này!',
                                confirmButtonColor: '#6366f1'
                            });
                            return; 
                        }
                        
                        matchingQuizIds.forEach(quizId => {
                            clearQuizVisualState(quizId);
                            // We do NOT delete data from savedProgress!
                        });
                    } else {
                        // Restore visual state for all questions when switching back to 'all'
                        Object.keys(savedProgress).forEach(quizIdStr => {
                            restoreQuizVisualState(parseInt(quizIdStr));
                        });
                    }
                    
                    // 3. Update styling
                    currentFilter = filter;
                    document.querySelectorAll('.filter-btn').forEach(b => {
                        b.classList.remove('btn-primary', 'btn-danger', 'btn-warning', 'shadow-sm');
                        if (b.dataset.filter === 'all') b.classList.add('btn-outline-primary');
                        if (b.dataset.filter === 'wrong') b.classList.add('btn-outline-danger');
                        if (b.dataset.filter === 'starred') b.classList.add('btn-outline-warning', 'text-dark');
                    });
                    
                    this.classList.remove('btn-outline-primary', 'btn-outline-danger', 'btn-outline-warning');
                    this.classList.add('shadow-sm');
                    if (this.dataset.filter === 'all') this.classList.add('btn-primary');
                    if (this.dataset.filter === 'wrong') this.classList.add('btn-danger', 'text-white');
                    if (this.dataset.filter === 'starred') this.classList.add('btn-warning', 'text-dark');
                    
                    // 4. Show/Hide in DOM
                    document.querySelectorAll('.quiz-item').forEach(item => {
                        const quizIdStr = item.id.replace('quiz_', '');
                        const quizId = parseInt(quizIdStr);
                        
                        let show = false;
                        if (filter === 'all') show = true;
                        else if (matchingQuizIds.includes(quizId)) show = true;
                        
                        if (show) {
                            item.classList.remove('d-none');
                        } else {
                            item.classList.add('d-none');
                        }
                        
                        const idxBtn = document.getElementById(`index_btn_${quizId}`);
                        if (idxBtn) {
                            if (show) idxBtn.classList.remove('d-none');
                            else idxBtn.classList.add('d-none');
                        }
                    });
                });
            });

            document.querySelectorAll('.btn-color-pick').forEach(btn => {
                btn.addEventListener('click', function() {
                    if (!currentHighlightRange || !currentQuizContent) return;
                    
                    const color = this.getAttribute('data-color');
                    const mark = document.createElement('mark');
                    mark.style.backgroundColor = color;
                    mark.className = 'text-dark rounded px-1 fw-bold';
                    
                    try {
                        currentHighlightRange.surroundContents(mark);
                    } catch(e) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Không thể highlight',
                            text: 'Vui lòng bôi đen đoạn văn bản liền mạch không chứa ngắt dòng hoặc cấu trúc phức tạp.',
                            confirmButtonColor: '#6366f1'
                        });
                    }
                    
                    window.getSelection().removeAllRanges();
                    tooltip.classList.add('d-none');
                    currentHighlightRange = null;
                    
                    const quizId = currentQuizContent.dataset.quizId;
                    if (!savedProgress[quizId]) savedProgress[quizId] = {};
                    savedProgress[quizId].htmlContent = currentQuizContent.innerHTML;
                    localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                });
            });

            // Remove highlight on click
            document.addEventListener('click', function(e) {
                if (e.target.tagName === 'MARK') {
                    const text = document.createTextNode(e.target.textContent);
                    const qContent = e.target.closest('.q-content');
                    e.target.parentNode.replaceChild(text, e.target);
                    
                    if (qContent) {
                        const quizId = qContent.dataset.quizId;
                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].htmlContent = qContent.innerHTML;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                    }
                }
            });

            // Save radio selection when clicked
            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const nameAttr = this.getAttribute('name');
                    const match = nameAttr.match(/answers\[(\d+)\]/);
                    if (match) {
                        const quizId = match[1];
                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].selectedAnswer = this.value;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                    }
                });
            });

            document.querySelectorAll('.check-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    window.getSelection().removeAllRanges();
                    const quizId = this.getAttribute('data-quiz-id');
                    
                    const selectedRadio = document.querySelector(`input[name="answers[${quizId}]"]:checked`);
                    if (!selectedRadio) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Thiếu thông tin',
                            text: 'Vui lòng chọn một đáp án trước khi kiểm tra!',
                            confirmButtonColor: '#6366f1'
                        });
                        return;
                    }
                    
                    const selectedAnswer = selectedRadio.value;
                    const explanationDiv = document.getElementById(`explanation_${quizId}`);
                    
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang phân tích...';
                    explanationDiv.classList.add('d-none');
                    explanationDiv.innerHTML = '';
                    
                    try {
                        const response = await fetch('/Lecture/CheckAnswer', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                quizId: parseInt(quizId),
                                selectedAnswer: selectedAnswer
                            })
                        });
                        
                        const result = await response.json();
                        
                        if (!response.ok) {
                            throw new Error(result.error || 'Lỗi hệ thống');
                        }
                        
                        // Save result
                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].selectedAnswer = selectedAnswer;
                        savedProgress[quizId].result = result;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                        
                        renderResult(quizId, result, selectedAnswer);
                        
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi hệ thống',
                            text: 'Đã xảy ra lỗi: ' + error.message,
                            confirmButtonColor: '#6366f1'
                        });
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-robot me-1"></i> Kiểm tra bằng AI';
                    }
                });
            });
        });
    </script>
}
