@model LexiLearn.ViewModels.LectureQuizViewModel
@{
    ViewData["Title"] = "Bai tap: " + Model.LectureTitle;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0 text-dark">Luyen tap trac nghiem</h2>
                    <p class="text-muted mb-0">Tu bai giang: <a href="/Lecture/Details/@Model.LectureId" class="text-primary text-decoration-none">@Model.LectureTitle</a></p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary p-2 fs-6"><i class="fas fa-list-ol me-1"></i> @Model.TotalQuestions cau hoi</span>
                </div>
            </div>

            <div class="card shadow-sm border-primary mb-4" style="border-width: 2px;">
                <div class="card-body p-5">
                    <div id="quizContainer">
                        <input type="hidden" id="lectureId" value="@Model.LectureId" />

                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];
                            <div class="quiz-item mb-5 pb-4 border-bottom border-light">
                                <h5 class="text-dark mb-4">
                                    <span class="badge bg-secondary me-2">Cau @(i + 1)</span> 
                                    @q.QuestionText
                                </h5>

                                <div class="options-container ms-3">
                                    @if (!string.IsNullOrEmpty(q.OptionA))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_a" value="A" required>
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_a">
                                                <span class="option-letter">A</span> @q.OptionA
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionB))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_b" value="B">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_b">
                                                <span class="option-letter">B</span> @q.OptionB
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionC))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_c" value="C">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_c">
                                                <span class="option-letter">C</span> @q.OptionC
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionD))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_d" value="D">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_d">
                                                <span class="option-letter">D</span> @q.OptionD
                                            </label>
                                        </div>
                                    }
                                </div>
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-primary check-btn shadow-sm" data-quiz-id="@q.QuizId" data-needs-analysis="@(string.IsNullOrEmpty(q.Explanation) ? "true" : "false")">
                                        <i class="fas fa-robot me-1"></i> Kiểm tra bằng AI
                                    </button>
                                </div>
                                <div id="explanation_@q.QuizId" class="mt-3 d-none p-4 rounded bg-light border border-info shadow-sm" style="font-size: 0.95em;">
                                    <!-- AI Explanation will be injected here -->
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-center mt-5">
                            <a href="/Lecture/Details/@Model.LectureId" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại bài giảng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-radio .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.4em;
        border-color: #6366f1;
    }
    .custom-radio .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }
    
    .option-label {
        transition: all 0.2s ease;
        cursor: pointer;
        border: 1px solid transparent;
    }
    
    .option-label:hover {
        background-color: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
    }
    
    .form-check-input:checked + .option-label {
        background-color: rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.5);
    }
    
    .option-letter {
        display: inline-block;
        width: 24px;
        height: 24px;
        background-color: rgba(255,255,255,0.1);
        text-align: center;
        border-radius: 50%;
        line-height: 24px;
        font-weight: bold;
        margin-right: 10px;
        font-size: 0.85em;
    }
    
    .form-check-input:checked + .option-label .option-letter {
        background-color: #6366f1;
        color: white;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Auto-preload AI explanations in the background for questions that haven't been analyzed yet
            setTimeout(async () => {
                const unanalyzedBtns = document.querySelectorAll('.check-btn[data-needs-analysis="true"]');
                for (let btn of unanalyzedBtns) {
                    const quizId = btn.getAttribute('data-quiz-id');
                    try {
                        // Silent background fetch to trigger GeminiQuizService and cache the result
                        await fetch('/Lecture/CheckAnswer', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                quizId: parseInt(quizId),
                                selectedAnswer: ""
                            })
                        });
                        // Once successfully cached, mark it so we don't fetch it again
                        btn.setAttribute('data-needs-analysis', 'false');
                    } catch (e) {
                        console.error('Preload failed for quiz', quizId, e);
                    }
                    // Wait 2 seconds between requests to avoid hitting rate limits
                    await new Promise(r => setTimeout(r, 2000));
                }
            }, 3000); // Start 3 seconds after page loads so we don't block initial rendering

            document.querySelectorAll('.check-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const quizId = this.getAttribute('data-quiz-id');
                    
                    // Find selected radio
                    const selectedRadio = document.querySelector(`input[name="answers[${quizId}]"]:checked`);
                    if (!selectedRadio) {
                        alert('Vui lòng chọn một đáp án trước khi kiểm tra!');
                        return;
                    }
                    
                    const selectedAnswer = selectedRadio.value;
                    const explanationDiv = document.getElementById(`explanation_${quizId}`);
                    
                    // Show loading
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang phân tích...';
                    explanationDiv.classList.add('d-none');
                    explanationDiv.innerHTML = '';
                    
                    try {
                        const response = await fetch('/Lecture/CheckAnswer', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                quizId: parseInt(quizId),
                                selectedAnswer: selectedAnswer
                            })
                        });
                        
                        const result = await response.json();
                        
                        if (!response.ok) {
                            throw new Error(result.error || 'Lỗi hệ thống');
                        }
                        
                        // Remove previous coloring
                        const radios = document.querySelectorAll(`input[name="answers[${quizId}]"]`);
                        radios.forEach(r => {
                            const label = document.querySelector(`label[for="${r.id}"]`);
                            label.classList.remove('bg-success', 'bg-danger', 'text-white', 'text-dark');
                            label.classList.add('text-dark');
                            
                            // Color correct answer
                            if (r.value === result.correctAnswer) {
                                label.classList.remove('text-dark');
                                label.classList.add('bg-success', 'text-white');
                            }
                            
                            // Color wrong selected answer
                            if (r.checked && !result.isCorrect) {
                                label.classList.remove('text-dark');
                                label.classList.add('bg-danger', 'text-white');
                            }
                            
                            // Disable inputs after checking
                            r.disabled = true;
                        });
                        
                        // Show explanation
                        explanationDiv.innerHTML = result.explanationHtml;
                        explanationDiv.classList.remove('d-none');
                        
                        // Update button state
                        this.innerHTML = '<i class="fas fa-check me-1"></i> Đã kiểm tra';
                        
                    } catch (error) {
                        alert('Đã xảy ra lỗi: ' + error.message);
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-robot me-1"></i> Kiểm tra bằng AI';
                    }
                });
            });
        });
    </script>
}
