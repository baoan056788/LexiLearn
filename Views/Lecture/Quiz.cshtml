@model LexiLearn.ViewModels.LectureQuizViewModel
@{
    ViewData["Title"] = "Bai tap: " + Model.LectureTitle;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="row">
        <!-- Main Quiz Content -->
        <div class="col-lg-9 col-md-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold mb-0 text-dark">Luyen tap trac nghiem</h2>
                    <p class="text-muted mb-0">Tu bai giang: <a href="/Lecture/Details/@Model.LectureId" class="text-primary text-decoration-none">@Model.LectureTitle</a></p>
                </div>
                <div class="text-end">
                    <span class="badge bg-primary p-2 fs-6"><i class="fas fa-list-ol me-1"></i> @Model.TotalQuestions cau hoi</span>
                </div>
            </div>

            <div class="card shadow-sm border-primary mb-4" style="border-width: 2px;">
                <div class="card-body p-5">
                    <div id="quizContainer">
                        <input type="hidden" id="lectureId" value="@Model.LectureId" />

                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];
                            <div class="quiz-item mb-5 pb-4 border-bottom border-light" id="quiz_@q.QuizId">
                                <h5 class="text-dark mb-4">
                                    <span class="badge bg-secondary me-2">Cau @(i + 1)</span> 
                                    @q.QuestionText
                                </h5>

                                <div class="options-container ms-3">
                                    @if (!string.IsNullOrEmpty(q.OptionA))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_a" value="A" required>
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_a">
                                                <span class="option-letter">A</span> @q.OptionA
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionB))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_b" value="B">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_b">
                                                <span class="option-letter">B</span> @q.OptionB
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionC))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_c" value="C">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_c">
                                                <span class="option-letter">C</span> @q.OptionC
                                            </label>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(q.OptionD))
                                    {
                                        <div class="form-check custom-radio mb-3">
                                            <input class="form-check-input" type="radio" name="answers[@q.QuizId]" id="q_@(q.QuizId)_d" value="D">
                                            <label class="form-check-label text-dark option-label p-2 w-100 rounded" for="q_@(q.QuizId)_d">
                                                <span class="option-letter">D</span> @q.OptionD
                                            </label>
                                        </div>
                                    }
                                </div>
                                <div class="mt-3">
                                    <button type="button" class="btn btn-sm btn-primary check-btn shadow-sm" data-quiz-id="@q.QuizId" data-needs-analysis="@(string.IsNullOrEmpty(q.Explanation) ? "true" : "false")">
                                        <i class="fas fa-robot me-1"></i> Kiểm tra bằng AI
                                    </button>
                                </div>
                                <div id="explanation_@q.QuizId" class="mt-3 d-none p-4 rounded bg-light border border-info shadow-sm" style="font-size: 0.95em;">
                                    <!-- AI Explanation will be injected here -->
                                </div>
                            </div>
                        }

                        <div class="d-flex justify-content-center mt-5">
                            <a href="/Lecture/Details/@Model.LectureId" class="btn btn-outline-secondary px-4 py-2 rounded-pill fw-semibold">
                                <i class="fas fa-arrow-left me-2"></i> Quay lại bài giảng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Sidebar Index -->
        <div class="col-lg-3 col-md-4">
            <div class="card shadow-sm border-0 sticky-top" style="top: 80px; z-index: 100;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold fs-6"><i class="fas fa-list-ol me-2"></i> Mục lục câu hỏi</h5>
                    <small class="text-white-50">Tổng cộng @Model.TotalQuestions câu</small>
                </div>
                <div class="card-body bg-light">
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            var q = Model.Questions[i];
                            <a href="#quiz_@q.QuizId" id="index_btn_@q.QuizId" class="btn btn-outline-secondary btn-sm" style="width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem; border-radius: 8px;">
                                @(i + 1)
                            </a>
                        }
                    </div>
                    <hr>
                    <div class="d-flex flex-column gap-2 small text-muted">
                        <div class="d-flex align-items-center"><div class="bg-success rounded me-2" style="width: 15px; height: 15px;"></div> Đã làm đúng</div>
                        <div class="d-flex align-items-center"><div class="bg-danger rounded me-2" style="width: 15px; height: 15px;"></div> Làm sai</div>
                        <div class="d-flex align-items-center"><div class="border border-secondary rounded me-2" style="width: 15px; height: 15px;"></div> Chưa kiểm tra</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-radio .form-check-input {
        width: 1.25em;
        height: 1.25em;
        margin-top: 0.4em;
        border-color: #6366f1;
    }
    .custom-radio .form-check-input:checked {
        background-color: #6366f1;
        border-color: #6366f1;
    }
    
    .option-label {
        transition: all 0.2s ease;
        cursor: pointer;
        border: 1px solid transparent;
    }
    
    .option-label:hover {
        background-color: rgba(255,255,255,0.05);
        border-color: rgba(255,255,255,0.1);
    }
    
    .form-check-input:checked + .option-label {
        background-color: rgba(99, 102, 241, 0.15);
        border-color: rgba(99, 102, 241, 0.5);
    }
    
    .option-letter {
        display: inline-block;
        width: 24px;
        height: 24px;
        background-color: rgba(255,255,255,0.1);
        text-align: center;
        border-radius: 50%;
        line-height: 24px;
        font-weight: bold;
        margin-right: 10px;
        font-size: 0.85em;
    }
    
    .form-check-input:checked + .option-label .option-letter {
        background-color: #6366f1;
        color: white;
    }

    html {
        scroll-behavior: smooth;
    }
    
    /* Highlight the target when scrolling to it */
    .quiz-item:target {
        animation: highlight 2s ease;
    }
    
    @@keyframes highlight {
        0% { background-color: rgba(99, 102, 241, 0.2); }
        100% { background-color: transparent; }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const lectureId = document.getElementById('lectureId').value;
            const storageKey = `lexilearn_quiz_progress_${lectureId}`;
            
            // Load saved progress
            let savedProgress = {};
            try {
                const stored = localStorage.getItem(storageKey);
                if (stored) {
                    savedProgress = JSON.parse(stored);
                }
            } catch (e) {
                console.error("Could not parse saved progress", e);
            }
            
            // Function to render AI result
            function renderResult(quizId, result, selectedAnswer) {
                const radios = document.querySelectorAll(`input[name="answers[${quizId}]"]`);
                radios.forEach(r => {
                    const label = document.querySelector(`label[for="${r.id}"]`);
                    label.classList.remove('bg-success', 'bg-danger', 'text-white', 'text-dark');
                    label.classList.add('text-dark');
                    
                    if (r.value === result.correctAnswer) {
                        label.classList.remove('text-dark');
                        label.classList.add('bg-success', 'text-white');
                    }
                    
                    if (r.value === selectedAnswer && !result.isCorrect) {
                        label.classList.remove('text-dark');
                        label.classList.add('bg-danger', 'text-white');
                    }
                    
                    r.disabled = true;
                    if (r.value === selectedAnswer) {
                        r.checked = true;
                    }
                });
                
                const explanationDiv = document.getElementById(`explanation_${quizId}`);
                explanationDiv.innerHTML = result.explanationHtml;
                explanationDiv.classList.remove('d-none');
                
                const btn = document.querySelector(`.check-btn[data-quiz-id="${quizId}"]`);
                if (btn) {
                    btn.innerHTML = '<i class="fas fa-check me-1"></i> Đã kiểm tra';
                    btn.disabled = true;
                }
                
                const indexBtn = document.getElementById(`index_btn_${quizId}`);
                if (indexBtn) {
                    indexBtn.classList.remove('btn-outline-secondary');
                    indexBtn.classList.add('text-white');
                    if (result.isCorrect) {
                        indexBtn.classList.add('btn-success');
                    } else {
                        indexBtn.classList.add('btn-danger');
                    }
                }
            }

            // Restore state on load
            Object.keys(savedProgress).forEach(quizIdStr => {
                const quizId = parseInt(quizIdStr);
                const data = savedProgress[quizIdStr];
                
                if (data.selectedAnswer && !data.result) {
                    const radio = document.querySelector(`input[name="answers[${quizId}]"][value="${data.selectedAnswer}"]`);
                    if (radio) radio.checked = true;
                }
                
                if (data.result) {
                    renderResult(quizId, data.result, data.selectedAnswer);
                }
            });

            // Save radio selection when clicked
            document.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    const nameAttr = this.getAttribute('name');
                    const match = nameAttr.match(/answers\[(\d+)\]/);
                    if (match) {
                        const quizId = match[1];
                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].selectedAnswer = this.value;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                    }
                });
            });

            document.querySelectorAll('.check-btn').forEach(btn => {
                btn.addEventListener('click', async function() {
                    const quizId = this.getAttribute('data-quiz-id');
                    
                    const selectedRadio = document.querySelector(`input[name="answers[${quizId}]"]:checked`);
                    if (!selectedRadio) {
                        alert('Vui lòng chọn một đáp án trước khi kiểm tra!');
                        return;
                    }
                    
                    const selectedAnswer = selectedRadio.value;
                    const explanationDiv = document.getElementById(`explanation_${quizId}`);
                    
                    this.disabled = true;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang phân tích...';
                    explanationDiv.classList.add('d-none');
                    explanationDiv.innerHTML = '';
                    
                    try {
                        const response = await fetch('/Lecture/CheckAnswer', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                quizId: parseInt(quizId),
                                selectedAnswer: selectedAnswer
                            })
                        });
                        
                        const result = await response.json();
                        
                        if (!response.ok) {
                            throw new Error(result.error || 'Lỗi hệ thống');
                        }
                        
                        // Save result
                        if (!savedProgress[quizId]) savedProgress[quizId] = {};
                        savedProgress[quizId].selectedAnswer = selectedAnswer;
                        savedProgress[quizId].result = result;
                        localStorage.setItem(storageKey, JSON.stringify(savedProgress));
                        
                        renderResult(quizId, result, selectedAnswer);
                        
                    } catch (error) {
                        alert('Đã xảy ra lỗi: ' + error.message);
                        this.disabled = false;
                        this.innerHTML = '<i class="fas fa-robot me-1"></i> Kiểm tra bằng AI';
                    }
                });
            });
        });
    </script>
}
