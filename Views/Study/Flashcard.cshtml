@model VocabularySet
@{
    ViewData["Title"] = "Flashcard - " + Model.Title;
}

<section class="page-header">
    <div class="container">
        <h1 class="fw-bold text-white"><i class="fas fa-clone me-2"></i>Flashcard</h1>
        <p class="text-white-50">@Model.Title • @Model.Cards.Count thẻ từ</p>
    </div>
</section>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Word Selection Toolbar -->
            <div class="d-flex justify-content-between align-items-center mb-3" id="selectionToolbar">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold text-muted small" id="selectedCountLabel">Đang học: tất cả @Model.Cards.Count từ</span>
                </div>
                <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="openSelectModal()">
                    <i class="fas fa-filter me-1"></i>Chọn từ để học
                </button>
            </div>

            <!-- Progress bar -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted" id="cardCounter">1 / @Model.Cards.Count</span>
                <div class="d-flex gap-2">
                    @if ((int)(ViewBag.DueCardCount ?? 0) > 0)
                    {
                        <span class="badge bg-info-subtle text-info">
                            <i class="fas fa-calendar-check me-1"></i>Đến hạn ôn: @ViewBag.DueCardCount
                        </span>
                    }
                    <span class="badge bg-success-subtle text-success" id="knownCount">
                        <i class="fas fa-check me-1"></i>Đã thuộc: 0
                    </span>
                    <span class="badge bg-warning-subtle text-warning" id="learningCount">
                        <i class="fas fa-redo me-1"></i>Cần học: 0
                    </span>
                </div>
            </div>
            <div class="progress mb-4" style="height: 6px;">
                <div class="progress-bar bg-gradient-primary" id="progressBar" style="width: 0%"></div>
            </div>

<!-- Word Selection Modal -->
<div class="modal fade" id="selectWordsModal" tabindex="-1" aria-labelledby="selectWordsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0" style="background: linear-gradient(135deg,#4e54c8,#8f94fb); border-radius: 16px 16px 0 0;">
                <h5 class="modal-title fw-bold text-white" id="selectWordsModalLabel">
                    <i class="fas fa-list-check me-2"></i>Chọn từ để tập trung học
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="selectAllWords()">
                            <i class="fas fa-check-double me-1"></i>Chọn tất cả
                        </button>
                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="deselectAllWords()">
                            <i class="fas fa-xmark me-1"></i>Bỏ chọn tất cả
                        </button>
                    </div>
                    <span class="text-muted small fw-semibold" id="modalSelectedCount">0 từ được chọn</span>
                </div>
                <!-- Search inside modal -->
                <div class="input-group mb-3">
                    <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 bg-light" id="modalSearchInput" placeholder="Tìm từ..." oninput="filterModalWords()">
                </div>
                <div id="wordCheckboxList" class="row g-2">
                    <!-- populated by JS -->
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-gradient rounded-pill px-4 fw-semibold" onclick="applyWordSelection()">
                    <i class="fas fa-play me-2"></i>Bắt đầu học
                </button>
            </div>
        </div>
    </div>
</div>



            <!-- Flashcard -->
            <div class="flashcard-container" id="flashcardContainer">
                <div class="flashcard" id="flashcard" onclick="flipCard()">
                    <div class="flashcard-front">
                        <div class="flashcard-content position-relative">
                            <button class="btn btn-light rounded-circle position-absolute top-0 end-0 m-3 shadow-sm" style="width: 40px; height: 40px;" id="btnSpeakFront" onclick="speakCurrentCard(event)" title="Nghe phát âm">
                                <i class="fas fa-volume-up text-primary"></i>
                            </button>
                            <h2 class="term-text" id="termText"></h2>
                            <p class="ipa-text" id="ipaText"></p>
                        </div>
                        <p class="flip-hint"><i class="fas fa-sync-alt me-1"></i>Nhấn để lật thẻ</p>
                    </div>
                    <div class="flashcard-back">
                        <div class="flashcard-content">
                            <h3 class="meaning-text" id="meaningText"></h3>
                            <p class="example-text" id="exampleText"></p>
                        </div>
                        <p class="flip-hint"><i class="fas fa-sync-alt me-1"></i>Nhấn để lật lại</p>
                    </div>
                </div>
            </div>

            <!-- Controls -->
            <div class="d-flex justify-content-center gap-3 mt-4" id="cardControls">
                <button class="btn btn-danger btn-lg rounded-pill px-4" onclick="markCard(false)" id="btnNotKnown">
                    <i class="fas fa-times me-2"></i>Chưa thuộc
                </button>
                <button class="btn btn-outline-secondary btn-lg rounded-circle" onclick="prevCard()" id="btnPrev">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="btn btn-outline-secondary btn-lg rounded-circle" onclick="nextCardOnly()" id="btnNext">
                    <i class="fas fa-chevron-right"></i>
                </button>
                <button class="btn btn-success btn-lg rounded-pill px-4" onclick="markCard(true)" id="btnKnown">
                    <i class="fas fa-check me-2"></i>Đã thuộc
                </button>
            </div>

            <!-- Results (hidden initially) -->
            <div class="glass-card mt-4 d-none" id="resultsSection" style="max-width: 900px; margin: auto;">
                <div class="d-flex justify-content-between align-items-center mb-5">
                    <h2 class="fw-bold mb-0">Tuyệt vời! Bạn đã gần tới đích.</h2>
                    <div style="font-size: 3rem;">🎉</div>
                </div>

                <div class="row">
                    <div class="col-md-6 border-end">
                        <h5 class="fw-bold text-muted mb-4">Tiến độ của bạn</h5>
                        <div class="d-flex align-items-center">
                            <div class="position-relative me-4">
                                <!-- CSS Donut Chart -->
                                <div id="donutChart" style="width: 120px; height: 120px; border-radius: 50%; background: conic-gradient(#20c997 0% 70%, #ffc107 70% 100%); display: flex; align-items: center; justify-content: center;">
                                    <div style="width: 90px; height: 90px; border-radius: 50%; background-color: white; display: flex; align-items: center; justify-content: center;">
                                        <span id="donutPercent" class="fw-bold fs-4 text-secondary">70%</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between px-3 py-2 mb-2 rounded" style="background-color: #d1e7dd;">
                                    <span class="text-success fw-semibold">Đã biết</span>
                                    <span class="text-success fw-bold" id="finalKnown">29</span>
                                </div>
                                <div class="d-flex justify-content-between px-3 py-2 mb-2 rounded" style="background-color: #fff3cd;">
                                    <span class="text-warning fw-semibold">Đang học</span>
                                    <span class="text-warning fw-bold" id="finalLearning">11</span>
                                </div>
                                <div class="d-flex justify-content-between px-3 py-2 rounded" style="background-color: #f8f9fa;">
                                    <span class="text-secondary fw-semibold">Còn lại</span>
                                    <span class="text-secondary fw-bold">0</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-6 ps-md-4">
                        <h5 class="fw-bold text-muted mb-4">Bước tiếp theo</h5>
                        <a href="/Learn/Index/@Model.SetId" class="btn btn-primary btn-lg rounded-pill w-100 mb-3 fw-bold shadow-sm" style="background: linear-gradient(135deg, #4e54c8, #8f94fb); border: none;">
                            <i class="fas fa-sync-alt me-2"></i>Ôn luyện với các câu hỏi
                        </a>
                        <button class="btn btn-light btn-lg rounded-pill w-100 mb-3 fw-semibold text-secondary shadow-sm" onclick="focusLearning()" id="btnFocusLearning">
                            Tập trung vào học 11 thẻ
                        </button>
                        <div class="text-center mt-3">
                            <a href="/VocabularySet/Details/@Model.SetId" class="text-muted text-decoration-none fw-semibold">Quay lại bộ từ</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const allCards = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Cards.Select(c => new {
        cardId = c.CardId,
        term = c.Term,
        meaning = c.Meaning,
        ipa = c.Ipa ?? "",
        example = c.Example ?? ""
    })));

    let currentCards = [...allCards];
    let currentIndex = 0;
    let results = {};
    let knownCount = 0;
    let learningCount = 0;

    function showCard(index) {
        const card = currentCards[index];
        document.getElementById('termText').textContent = card.term;
        document.getElementById('ipaText').textContent = card.ipa;
        document.getElementById('meaningText').textContent = card.meaning;
        document.getElementById('exampleText').textContent = card.example;
        document.getElementById('cardCounter').textContent = `${index + 1} / ${currentCards.length}`;
        document.getElementById('progressBar').style.width = `${((index + 1) / currentCards.length) * 100}%`;

        // Reset flip
        document.getElementById('flashcard').classList.remove('flipped');
    }

    function flipCard() {
        document.getElementById('flashcard').classList.toggle('flipped');
    }

    function speakCurrentCard(e) {
        if (e) e.stopPropagation();
        const card = currentCards[currentIndex];
        if (card && card.term) {
            speakEnglish(card.term);
        }
    }

    function markCard(isKnown) {
        const card = currentCards[currentIndex];
        results[card.cardId] = isKnown;

        if (isKnown) knownCount++;
        else learningCount++;

        document.getElementById('knownCount').innerHTML = `<i class="fas fa-check me-1"></i>Đã thuộc: ${knownCount}`;
        document.getElementById('learningCount').innerHTML = `<i class="fas fa-redo me-1"></i>Cần học: ${learningCount}`;

        if (currentIndex < currentCards.length - 1) {
            currentIndex++;
            showCard(currentIndex);
        } else {
            showResults();
        }
    }

    function nextCardOnly() {
        if (currentIndex < currentCards.length - 1) {
            currentIndex++;
            showCard(currentIndex);
        }
    }

    function prevCard() {
        if (currentIndex > 0) {
            currentIndex--;
            showCard(currentIndex);
        }
    }

    function showResults() {
        document.getElementById('flashcardContainer').classList.add('d-none');
        document.getElementById('cardControls').classList.add('d-none');
        document.getElementById('resultsSection').classList.remove('d-none');
        
        document.getElementById('finalKnown').textContent = knownCount;
        document.getElementById('finalLearning').textContent = learningCount;
        
        let percent = 0;
        if (currentCards.length > 0) {
            percent = Math.round((knownCount / currentCards.length) * 100);
        }
        
        document.getElementById('donutPercent').textContent = percent + '%';
        document.getElementById('donutChart').style.background = `conic-gradient(#20c997 0% ${percent}%, #ffc107 ${percent}% 100%)`;
        
        document.getElementById('btnFocusLearning').textContent = `Tập trung vào học ${learningCount} thẻ chưa thuộc`;
        if (learningCount === 0) {
            document.getElementById('btnFocusLearning').classList.add('d-none');
        } else {
            document.getElementById('btnFocusLearning').classList.remove('d-none');
        }

        // Save results
        fetch('/Study/SaveFlashcardResult', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                setId: @Model.SetId,
                results: Object.entries(results).map(([cardId, isKnown]) => ({ cardId: parseInt(cardId), isKnown }))
            })
        });
    }

    function focusLearning() {
        currentCards = currentCards.filter(c => results[c.cardId] === false);
        resetState();
    }

    function restartFlashcard() {
        currentCards = [...allCards];
        resetState();
    }

    function resetState() {
        currentIndex = 0;
        results = {};
        knownCount = 0;
        learningCount = 0;
        document.getElementById('knownCount').innerHTML = '<i class="fas fa-check me-1"></i>Đã thuộc: 0';
        document.getElementById('learningCount').innerHTML = '<i class="fas fa-redo me-1"></i>Cần học: 0';
        document.getElementById('flashcardContainer').classList.remove('d-none');
        document.getElementById('cardControls').classList.remove('d-none');
        document.getElementById('resultsSection').classList.add('d-none');
        if (currentCards.length > 0) showCard(0);
    }

    // ── Word Selection Modal ──
    let selectModal = null;

    function openSelectModal() {
        const list = document.getElementById('wordCheckboxList');
        list.innerHTML = '';
        document.getElementById('modalSearchInput').value = '';

        allCards.forEach(card => {
            const isActive = currentCards.some(c => c.cardId === card.cardId);
            const col = document.createElement('div');
            col.className = 'col-md-6 word-check-item';
            col.dataset.term = card.term.toLowerCase();
            col.dataset.meaning = card.meaning.toLowerCase();
            col.innerHTML = `
                <label class="d-flex align-items-center gap-2 p-2 rounded-3 border w-100 h-100 cursor-pointer word-check-label ${isActive ? 'border-primary bg-primary-subtle' : 'bg-light'}" style="cursor:pointer;">
                    <input type="checkbox" class="form-check-input flex-shrink-0 mt-0" value="${card.cardId}" ${isActive ? 'checked' : ''} onchange="onWordCheckChange(this)">
                    <div class="overflow-hidden">
                        <div class="fw-semibold text-truncate">${card.term}</div>
                        <div class="text-muted small text-truncate">${card.meaning}</div>
                    </div>
                </label>`;
            list.appendChild(col);
        });

        updateModalCount();

        if (!selectModal) {
            selectModal = new bootstrap.Modal(document.getElementById('selectWordsModal'));
        }
        selectModal.show();
    }

    function onWordCheckChange(checkbox) {
        const label = checkbox.closest('.word-check-label');
        if (checkbox.checked) {
            label.classList.add('border-primary', 'bg-primary-subtle');
            label.classList.remove('bg-light');
        } else {
            label.classList.remove('border-primary', 'bg-primary-subtle');
            label.classList.add('bg-light');
        }
        updateModalCount();
    }

    function updateModalCount() {
        const checked = document.querySelectorAll('#wordCheckboxList input[type="checkbox"]:checked').length;
        document.getElementById('modalSelectedCount').textContent = `${checked} từ được chọn`;
    }

    function selectAllWords() {
        document.querySelectorAll('#wordCheckboxList .word-check-item:not([style*="display: none"]) input[type="checkbox"]').forEach(cb => {
            cb.checked = true;
            onWordCheckChange(cb);
        });
    }

    function deselectAllWords() {
        document.querySelectorAll('#wordCheckboxList .word-check-item:not([style*="display: none"]) input[type="checkbox"]').forEach(cb => {
            cb.checked = false;
            onWordCheckChange(cb);
        });
    }

    function filterModalWords() {
        const q = document.getElementById('modalSearchInput').value.toLowerCase();
        document.querySelectorAll('#wordCheckboxList .word-check-item').forEach(item => {
            const match = item.dataset.term.includes(q) || item.dataset.meaning.includes(q);
            item.style.display = match ? '' : 'none';
        });
        updateModalCount();
    }

    function applyWordSelection() {
        const checked = [...document.querySelectorAll('#wordCheckboxList input[type="checkbox"]:checked')].map(cb => parseInt(cb.value));
        if (checked.length === 0) {
            Swal.fire({ icon: 'warning', title: 'Chưa chọn từ nào!', text: 'Vui lòng chọn ít nhất 1 từ để học.', confirmButtonColor: '#4e54c8' });
            return;
        }
        currentCards = allCards.filter(c => checked.includes(c.cardId));
        const label = document.getElementById('selectedCountLabel');
        if (currentCards.length === allCards.length) {
            label.textContent = `Đang học: tất cả ${allCards.length} từ`;
            label.className = 'fw-semibold text-muted small';
        } else {
            label.innerHTML = `<i class="fas fa-filter me-1 text-primary"></i>Đang học: <span class="text-primary fw-bold">${currentCards.length}</span> / ${allCards.length} từ`;
        }
        if (selectModal) selectModal.hide();
        resetState();
    }

    // Initialize
    if (currentCards.length > 0) showCard(0);

</script>
}
