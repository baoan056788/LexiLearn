@model VocabularyCardViewModel
@{
    ViewData["Title"] = "Chỉnh sửa thẻ từ";
}

<section class="page-header">
    <div class="container">
        <h1 class="fw-bold text-white"><i class="fas fa-edit me-2"></i>Chỉnh sửa thẻ từ</h1>
    </div>
</section>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="glass-card">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CardId" />
                    <input type="hidden" asp-for="SetId" />

                    <div class="mb-3">
                        <label asp-for="Term" class="form-label fw-semibold"></label>
                        <input asp-for="Term" class="form-control" placeholder="e.g. in the event of, in case of" />
                        <div class="form-text"><i class="fas fa-info-circle me-1 text-info"></i>Có thể nhập nhiều từ tiếng Anh đồng nghĩa, phân cách bằng dấu phẩy.</div>
                        <span asp-validation-for="Term" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Meaning" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Meaning" id="editMeaning" class="form-control" />
                            <button type="button" class="btn btn-outline-info" title="Gợi ý từ đồng nghĩa bằng AI" onclick="generateSynonyms('editMeaning', this)"><i class="fas fa-magic"></i> AI</button>
                        </div>
                        <span asp-validation-for="Meaning" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Ipa" class="form-label fw-semibold"></label>
                        <input asp-for="Ipa" class="form-control" placeholder="/ɪɡˈzæm.pəl/" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Example" class="form-label fw-semibold"></label>
                        <textarea asp-for="Example" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary-gradient px-4"><i class="fas fa-save me-2"></i>Lưu</button>
                        <a href="/VocabularySet/Details/@Model.SetId" class="btn btn-outline-secondary px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
async function generateSynonyms(inputId, btnElement) {
    const input = document.getElementById(inputId);
    const meaning = input.value.trim();
    if (!meaning) {
        alert('Vui lòng nhập nghĩa tiếng Việt trước!');
        return;
    }
    
    const originalHtml = btnElement.innerHTML;
    btnElement.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
    btnElement.disabled = true;
    
    try {
        const response = await fetch('/api/ai/synonyms?meaning=' + encodeURIComponent(meaning));
        if (response.ok) {
            const synonyms = await response.json();
            if (synonyms && synonyms.length > 0) {
                const currentMeanings = meaning.split(/[,;]/).map(m => m.trim()).filter(m => m);
                const newMeanings = synonyms.filter(s => !currentMeanings.includes(s.toLowerCase()));
                if (newMeanings.length > 0) {
                    input.value = meaning + ', ' + newMeanings.join(', ');
                }
            }
        }
    } catch (e) {
        console.error(e);
    } finally {
        btnElement.innerHTML = originalHtml;
        btnElement.disabled = false;
    }
}
</script>
}
